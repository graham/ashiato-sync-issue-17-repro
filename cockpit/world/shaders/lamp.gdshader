// A TOWN'S LAMPS, THE SAME ON BOTH FINISHES: a point of light has nothing to be finer about. See lamp.gdshaderinc, which is
// the whole of it.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled;

#include "res://world/shaders/lamp.gdshaderinc"
