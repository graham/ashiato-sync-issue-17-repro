// CUMULUS, ON THE PLAIN FINISH, ITS CORE: opaque, cut where the facing's coverage falls under the rim. See
// cumulus_plain_lump.gdshaderinc, and cumulus_plain_rim.gdshader for the soft edge drawn after it.
shader_type spatial;
render_mode unshaded, cull_back;

#include "res://world/shaders/cumulus_plain_lump.gdshaderinc"
