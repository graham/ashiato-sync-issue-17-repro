// TREES, ON THE PLAIN FINISH. Everything is in forest.gdshaderinc; this is that file without FINE:
// no wind, and the tree is the plain mesh `world/woodland.gd` builds for this finish.
shader_type spatial;
render_mode cull_back, diffuse_lambert, specular_disabled;

#include "res://world/shaders/forest.gdshaderinc"
