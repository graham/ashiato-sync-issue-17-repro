; KOKORO-GD, LOADED BY `PilotHeadphones` AND NOT BY THE IMPORTER.
;
; This folder has a .gdignore, so Godot never finds this file on its own. An extension it
; finds is loaded at every boot, and on a machine with no library for its platform and
; precision -- the Linux box, until its .so files are built there -- that prints "No
; GDExtension library found for current OS and architecture" as an ERROR, which fails every
; suite. autoload/headphones.gd reads the entries below, checks the one this machine would
; load is present, and only then calls GDExtensionManager.load_extension.
;
; THE LIBRARIES ARE NOT COMMITTED (see the .gitignore beside this). Built from ../kokoro-gd with
; scripts/build.ps1 and -Double, which copy both libraries and onnxruntime.dll here. A clone has
; none, and the clipboard's VOICE switch says so and names that command.

[configuration]

entry_symbol = "kokoro_library_init"
; Bound against the 4.7.2 editors' own extension_api.json, as ashiato is.
compatibility_minimum = "4.7"
reloadable = false

[libraries]

; TAGGED BY PRECISION, both of them. A double-precision Godot reports every tag a single one
; does EXCEPT `single`, so an untagged entry matches a double editor and loads the single
; library into it. See addons/ashiato/ashiato.gdextension for the crash that paid for this.

windows.debug.single.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.windows.x86_64.dll"
windows.release.single.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.windows.x86_64.dll"
windows.debug.double.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.windows.x86_64.double.dll"
windows.release.double.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.windows.x86_64.double.dll"

linux.debug.single.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.linux.x86_64.so"
linux.release.single.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.linux.x86_64.so"
linux.debug.double.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.linux.x86_64.double.so"
linux.release.double.x86_64 = "res://addons/kokoro_gd/bin/libkokoro_gd.linux.x86_64.double.so"

[dependencies]

windows.debug.x86_64 = { "res://addons/kokoro_gd/bin/onnxruntime.dll" : "" }
windows.release.x86_64 = { "res://addons/kokoro_gd/bin/onnxruntime.dll" : "" }
linux.debug.x86_64 = { "res://addons/kokoro_gd/bin/libonnxruntime.so.1" : "" }
linux.release.x86_64 = { "res://addons/kokoro_gd/bin/libonnxruntime.so.1" : "" }
